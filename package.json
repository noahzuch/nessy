{
  "name": "nessy",
  "version": "0.2.0",
  "description": "Claude Code plugin: AI development workflow enforcement",
  "type": "module",
  "bin": {
    "nessy": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias && node scripts/merge-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs}\" && prettier --write --no-error-on-unmatched-pattern \".claude/skills/vendor-sync/scripts/*.mjs\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs}\" && prettier --check --no-error-on-unmatched-pattern \".claude/skills/vendor-sync/scripts/*.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "prettier": "^3.8.4",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "ignore": "^5.3.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  }
}
